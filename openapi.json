{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter API",
    "description": "\nA clean REST API in front of the legacy **Urja Meter Ops** portal.\n\n* Meter data comes from the portal's bulk export (one request), cached in memory.\n* Consumption is fetched per meter on demand and cached.\n* Data-quality problems in the portal are **flagged, not hidden** (see `/quality`).\n* Timestamps are ISO 8601. The portal gives no timezone; India Standard Time is assumed.\n",
    "version": "1.0.0"
  },
  "paths": {
